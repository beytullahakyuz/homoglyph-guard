{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homoglyph Guard",
  "version": "0.1.0",
  "identifier": "com.homoglyphguard.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "alert",
        "title": "Homoglyph Guard",
        "width": 420,
        "height": 300,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": true
      },
      {
        "label": "about",
        "url": "about.html",
        "title": "Homoglyph Guard",
        "width": 400,
        "height": 460,
        "visible": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "shortDescription": "Fake domain (homoglyph) detector for the clipboard",
    "category": "Utility"
  }
}
